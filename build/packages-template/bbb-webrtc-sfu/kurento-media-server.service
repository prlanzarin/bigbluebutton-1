[Unit]
Description=Kurento Media Server (Docker)
After=docker.service
Requires=docker.service

[Service]
ExecStartPre=-/usr/bin/docker exec %n stop
ExecStartPre=-/usr/bin/docker rm %n
ExecStartPre=/usr/bin/docker pull mconf/kurento:6.16.0-bionic-1
ExecStart=/usr/bin/docker run --rm --name %n \
  -v /var/kurento:/var/kurento \
  -v /var/log/kurento-media-server:/var/log/kurento-media-server \
  --network=host \
  --env-file /etc/bigbluebutton/kurento.env \
  mconf/kurento:6.16.0-bionic-1
Restart=always

[Install]
WantedBy=default.target

